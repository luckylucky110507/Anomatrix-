APP_NAME=anomatrix
ENVIRONMENT=development
DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

DATASET_PATH=data/raw/telemetry_events.csv
MODEL_ARTIFACT_PATH=artifacts/models/autoencoder.pt
SCALER_PATH=artifacts/scalers/minmax_scaler.pkl
MODEL_VERSION=v1.0.0
ANOMALY_THRESHOLD=3.0
RANDOM_SEED=42

# Local development database. Replace with a private MySQL URL if needed.
DATABASE_URL=sqlite:///./data/anomatrix.db
# Example: mysql+pymysql://USER:PASSWORD@localhost:3306/anomatrix
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=telemetry-events
KAFKA_CONSUMER_GROUP=anomatrix-consumers

LOG_LEVEL=INFO
